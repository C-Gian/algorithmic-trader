+@media (max-width: 760px) {
+  .persp-row { grid-template-columns: 1fr; gap: var(--s-2); }
+  .strip-levels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .market-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .strip-head { align-items: flex-start; flex-direction: column; gap: var(--s-2); }
+  .decision { padding: var(--s-4); }
+  .cockpit-chart { display: flex; }
+}
