+.live-chart.is-candles .band-label { font-size: 11px; fill: var(--info); font-weight: 600; }
+.live-chart.is-candles .last-tag line { stroke: var(--text-3); stroke-dasharray: 1 3; }
+.live-chart.is-candles .axis { stroke: var(--line-3); }
+.live-chart.is-candles .tick { font-size: 11px; fill: var(--text-3); font-family: var(--font-mono); }
