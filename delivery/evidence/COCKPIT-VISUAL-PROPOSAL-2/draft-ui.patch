+.lg-band { width: 18px; height: 10px; display: inline-block; border-radius: 2px; }
+.lg-area { background: rgba(205, 178, 122, 0.25); }
+.lg-adm { background: rgba(108, 182, 224, 0.35); border: 1px solid var(--info); }
+@media (max-width: 1100px) {
