+.cockpit-main { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-4); align-items: start; }
+.cockpit-chart { min-width: 0; display: flex; flex-direction: column; gap: var(--s-4); }
+.cockpit-decision { min-width: 0; }
