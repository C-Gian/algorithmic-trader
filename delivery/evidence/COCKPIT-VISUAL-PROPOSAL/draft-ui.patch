@@ -163,3 +163,42 @@
 /* live main panel: the issued call's update kept apart from new-entry availability */
 .proposal-group { border-top: 1px solid var(--line, rgba(127, 127, 127, 0.35)); padding-top: var(--s-2); display: flex; flex-direction: column; gap: var(--s-2); }
 .proposal-group blockquote, .proposal-guidance blockquote { margin: 2px 0 0; padding-left: var(--s-2); border-left: 2px solid var(--line, rgba(127, 127, 127, 0.35)); overflow-wrap: anywhere; }
+/* ===== DRAFT (visual proposal only): decision area ===== */
+.decision { padding: var(--s-5); border-radius: var(--radius-lg); border: 1px solid var(--line-2); background: var(--surface-2); display: flex; flex-direction: column; gap: var(--s-3); }
+.decision-head { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
+.decision-meta { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
+.decision-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr); gap: var(--s-5); align-items: start; }
+.decision-call { display: flex; flex-direction: column; gap: var(--s-3); min-width: 0; }
+.persp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
+.persp-card { border: 1px solid var(--line-2); border-radius: var(--radius); padding: var(--s-4); background: var(--surface); display: flex; flex-direction: column; gap: var(--s-3); min-width: 0; }
+.persp-title { font-size: var(--fs-md); font-weight: 650; color: var(--text); }
+.persp-state { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 700; line-height: 1.25; padding: 10px 14px; border-radius: var(--radius); border-left: 4px solid currentColor; }
+.persp-guidance { font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 700; line-height: 1.3; padding: 10px 14px; border-radius: var(--radius); background: var(--surface-3); color: var(--text); border-left: 4px solid var(--line-3); }
+.sig-avail { color: var(--info); background: var(--info-soft); }
+.sig-attn { color: var(--warn); background: var(--warn-soft); }
+.sig-muted, .sig-done { color: var(--neutral); background: var(--neutral-soft); }
+.sig-tech { color: var(--warn); background: var(--warn-soft); border: 1px dashed var(--warn); }
+.sig-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: var(--fs-sm); font-weight: 600; }
+.dir-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 12px; border-radius: 999px; border: 1px solid currentColor; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); }
+.dir-long { color: var(--pos); }
+.dir-short { color: var(--neg); }
+.dir-chip.is-ended { color: var(--neutral); border-style: dashed; }
+.call-strip { display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-3) var(--s-4); border-radius: var(--radius); background: var(--surface-3); }
+.call-strip.is-none { border: 1px dashed var(--line-3); background: transparent; }
+.strip-head { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
+.strip-title { font-weight: 650; }
+.strip-levels { display: grid; grid-template-columns: repeat(5, minmax(0, auto)); gap: var(--s-2) var(--s-5); margin: 0; }
+.strip-levels dt { font-size: var(--fs-xs); color: var(--text-3); }
+.strip-levels dd { margin: 0; font-size: var(--fs-md); }
+.decision-market { border: 1px dashed var(--line-3); border-radius: var(--radius); padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2); }
+.market-facts { grid-template-columns: minmax(0, 1fr); gap: 2px; }
+.market-facts dd { margin-bottom: 6px; }
+.live-board { display: flex; flex-direction: column; gap: var(--s-4); }
+.live-board-lower { display: grid; grid-template-columns: minmax(0, 3fr) minmax(320px, 2fr); gap: var(--s-4); align-items: start; }
+@media (max-width: 1100px) {
+  .decision-grid, .live-board-lower { grid-template-columns: 1fr; }
+}
+@media (max-width: 760px) {
+  .persp-grid { grid-template-columns: 1fr; }
+  .strip-levels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
