    "Protected": "#/$defs/Protected",
    "SourceSlice": "#/$defs/SourceSlice",
    "Window": "#/$defs/Window",
    "WindowCounts": "#/$defs/WindowCounts"
  },
  "revision": 2,
  "schema_version": "algotrader.corpus-pack.v1",
  "slice_policy": "corpus.slice.bound-first-then-longest-covering.v1",
  "status": "PROVISIONAL",
  "title": "Algorithmic Trader evaluation pack contracts (algotrader.corpus-pack.v1, PROVISIONAL)"
