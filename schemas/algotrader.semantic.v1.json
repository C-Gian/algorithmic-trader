          "type": "array"
        },
        "current_exposure": {
          "$ref": "#/$defs/ExposureSummary"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "permitted_action": {
          "$ref": "#/$defs/Action"
        },
        "plan_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan Ref"
        },
        "proposed_action": {
          "$ref": "#/$defs/Action"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "risk_decision_ref": {
          "title": "Risk Decision Ref",
          "type": "string"
        },
        "target_quantity": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Target Quantity",
          "type": "string"
        },
        "view_ref": {
          "title": "View Ref",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "as_of",
        "view_ref",
        "plan_ref",
        "risk_decision_ref",
        "proposed_action",
        "permitted_action",
        "blocking_reasons",
        "reason",
        "current_exposure",
        "target_quantity"
      ],
      "title": "Decision",
      "type": "object"
    },
    "ExposureSummary": {
      "additionalProperties": false,
      "properties": {
        "exposure_fraction": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Exposure Fraction",
          "type": "string"
        },
        "notional": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Notional",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Quantity",
          "type": "string"
        },
        "side": {
          "enum": [
            "LONG",
            "SHORT",
            "FLAT"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "side",
        "quantity",
        "notional",
        "exposure_fraction"
      ],
