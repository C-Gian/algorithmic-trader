{
  "$defs": {
    "AccountSnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "collateral_balance": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Collateral Balance",
          "type": "string"
        },
        "equity": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Equity",
          "type": "string"
        },
        "exposure_fraction": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Exposure Fraction",
          "type": "string"
        },
        "exposure_notional": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Exposure Notional",
          "type": "string"
        },
        "fees_paid": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Fees Paid",
          "type": "string"
        },
        "funding": {
          "const": "NOT_MODELED",
          "default": "NOT_MODELED",
          "title": "Funding",
          "type": "string"
        },
        "mark_price": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mark Price"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "realized_pnl": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Realized Pnl",
          "type": "string"
        },
        "unrealized_pnl": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Unrealized Pnl",
          "type": "string"
        }
      },
      "required": [
        "as_of",
        "collateral_balance",
        "realized_pnl",
        "unrealized_pnl",
        "fees_paid",
        "equity",
        "mark_price",
        "position",
        "exposure_notional",
        "exposure_fraction"
      ],
      "title": "AccountSnapshot",
      "type": "object"
    },
    "Action": {
      "enum": [
        "LONG",
        "SHORT",
        "NO_TRADE",
        "HOLD",
        "REDUCE",
        "EXIT"
      ],
      "title": "Action",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rows"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "sha256",
        "rows",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Bias": {
      "enum": [
        "BULLISH",
        "BEARISH",
        "BALANCED",
        "UNCERTAIN"
      ],
      "title": "Bias",
      "type": "string"
    },
    "CostAssumptions": {
      "additionalProperties": false,
      "properties": {
        "fee_bps": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Fee Bps",
          "type": "string"
        },
        "funding": {
          "const": "NOT_MODELED",
          "default": "NOT_MODELED",
          "title": "Funding",
          "type": "string"
        },
        "label": {
          "const": "DEMO_PLACEHOLDER",
          "default": "DEMO_PLACEHOLDER",
          "title": "Label",
          "type": "string"
        },
        "slippage_bps": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Slippage Bps",
          "type": "string"
        }
      },
      "required": [
        "fee_bps",
        "slippage_bps"
      ],
      "title": "CostAssumptions",
      "type": "object"
    },
    "DataQuality": {
      "enum": [
        "OK",
        "MISSING",
        "STALE"
      ],
      "title": "DataQuality",
      "type": "string"
    },
    "DataQualityState": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "bars_since_valid": {
          "title": "Bars Since Valid",
          "type": "integer"
        },
        "last_valid_available_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Valid Available Time"
        },
        "last_valid_observation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Valid Observation Id"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/DataQuality"
        }
      },
      "required": [
        "status",
        "as_of",
        "last_valid_observation_id",
        "last_valid_available_time",
        "bars_since_valid"
      ],
      "title": "DataQualityState",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "blocking_reasons": {
          "items": {
            "type": "string"
          },
