          "type": "string"
        },
        "price_tick": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Price Tick",
          "type": "string"
        },
        "quantity_step": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
