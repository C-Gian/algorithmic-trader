      "type": "object"
    },
    "FaultMode": {
      "description": "Controlled worker interruption used to demonstrate recovery/failure.",
      "enum": [
        "none",
        "crash_once",
        "crash_always"
      ],
      "title": "FaultMode",
      "type": "string"
    },
    "Fill": {
