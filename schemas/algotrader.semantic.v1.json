        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "open": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Open"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume"
