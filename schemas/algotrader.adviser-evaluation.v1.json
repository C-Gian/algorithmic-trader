  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "changelog": [
    {
      "date": "2026-10-04",
      "note": "Initial provisional baseline (WP-009): evaluator profile, hypothetical path (primary, entry-delay sensitivities, horizon-only baseline), normalized one-unit accounting, view samples and report aggregates.",
      "revision": 1
    },
    {
      "date": "2026-10-05",
      "note": "WP-009 correction (additive, optional): HypotheticalPath.resolved_at - the professional clock time of the dispatch (or clock-end finish) at which the evaluator determined the path, so cutoff-safe inspection never shows an outcome before it was knowable. Revision-1 records remain readable (resolved_at absent = unknown; withheld under a cutoff).",
      "revision": 2
    }
  ],
  "public_contracts": {
    "EvaluatorProfile": "#/$defs/EvaluatorProfile",
    "Fill": "#/$defs/Fill",
    "HypotheticalPath": "#/$defs/HypotheticalPath",
    "ViewSample": "#/$defs/ViewSample"
  },
  "revision": 2,
