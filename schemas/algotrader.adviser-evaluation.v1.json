{
  "$defs": {
    "EvaluatorProfile": {
      "additionalProperties": false,
      "properties": {
        "adequacy_envelope_bps": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Adequacy Envelope Bps",
          "type": "string"
        },
        "allowance_per_leg": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Allowance Per Leg",
          "type": "string"
        },
        "boundary_alignment": {
          "default": "UTC_CEIL_MINUTE",
          "title": "Boundary Alignment",
          "type": "string"
        },
        "entry_delay_seconds": {
          "title": "Entry Delay Seconds",
          "type": "integer"
        },
        "exit_delay_seconds": {
          "title": "Exit Delay Seconds",
          "type": "integer"
        },
        "exit_mode": {
          "title": "Exit Mode",
          "type": "string"
        },
        "fee_per_leg": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Fee Per Leg",
          "type": "string"
        },
        "funding": {
          "title": "Funding",
          "type": "string"
        },
        "notional_unit": {
          "default": "N0=1 abstract USDT reporting unit; q=N0/E constant; not a human size",
          "title": "Notional Unit",
          "type": "string"
        },
        "opening_condition": {
          "default": "PREOPEN_EVIDENCE_PLUS_OWN_OPEN_GEOMETRY_NO_FUTURE_HLC",
          "title": "Opening Condition",
          "type": "string"
        },
        "profile_id": {
          "default": "mp001.evaluation.primary.v1",
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "entry_delay_seconds",
        "exit_delay_seconds",
        "fee_per_leg",
        "allowance_per_leg",
        "adequacy_envelope_bps",
        "funding",
        "exit_mode"
      ],
      "title": "EvaluatorProfile",
      "type": "object"
    },
    "Fill": {
      "additionalProperties": false,
      "properties": {
        "price": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Price",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "time_end": {
          "format": "date-time",
          "title": "Time End",
          "type": "string"
        },
        "time_start": {
          "format": "date-time",
          "title": "Time Start",
          "type": "string"
        }
      },
      "required": [
        "price",
        "reason",
        "time_start",
        "time_end"
      ],
      "title": "Fill",
      "type": "object"
    },
