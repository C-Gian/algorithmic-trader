    "DatasetRequest": {
      "additionalProperties": false,
      "description": "The logical request. Its hash identifies 'the same request' across fetches.",
      "properties": {
        "bar": {
          "const": "1m",
          "default": "1m",
          "title": "Bar",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
